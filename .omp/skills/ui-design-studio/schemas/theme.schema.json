{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Theme Module v1 (package contract)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "tokens",
    "styles",
    "icons",
    "preview",
    "compatibility",
    "budgets",
    "contrastPairs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "tokens": {
      "const": "tokens.json"
    },
    "styles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "icons": {
      "type": "string"
    },
    "preview": {
      "type": "string"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "themeApi",
        "framework"
      ],
      "properties": {
        "themeApi": {
          "const": "1"
        },
        "framework": {
          "type": "string"
        }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "maxRawBytes",
        "maxGzipBytes"
      ],
      "properties": {
        "maxRawBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxGzipBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contrastPairs": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "foreground",
          "background",
          "minimum"
        ],
        "properties": {
          "foreground": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "minimum": {
            "type": "number",
            "minimum": 3
          }
        }
      }
    }
  },
  "$comment": "studio.py performs path, supported token, CSS/SVG, required-pair and budget checks beyond this structural schema. This identifier is a local schema identity, not a remote service."
}
